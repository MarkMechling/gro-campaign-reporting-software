# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-client-id
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890

# Google Service Account (fuer BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Meta / Facebook
META_ACCESS_TOKEN=your-long-lived-access-token
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret

# BigQuery (Service Account braucht: BigQuery Data Editor + BigQuery Job User)
GRO_BQ_PROJECT=your-gcp-project-id
GRO_BQ_DATASET=gro_reporting
# GRO_BQ_LOCATION=EU
